# typescript-eslint 8.x declares a peer range of typescript ">=4.8.4 <6.1.0",
# but this project is on TypeScript 7. The conflict is limited to linting
# (see the note at the top of eslint.config.js); everything else builds and
# tests cleanly. Remove this once typescript-eslint supports TS >=7.1.
legacy-peer-deps=true
