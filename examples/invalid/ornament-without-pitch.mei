<?xml version="1.0" encoding="UTF-8"?>
<!-- Two whens on one note are that note played as an ornament, and the note gives only its own pitch. So each of them says what sounded. -->
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead>
      <fileDesc>
         <titleStmt>
            <title>A note of an ornament that does not say its pitch</title>
         </titleStmt>
         <pubStmt/>
      </fileDesc>
      <manifestationList>
         <manifestation xml:id="take-1">
            <physDesc>
               <p>A take.</p>
            </physDesc>
         </manifestation>
      </manifestationList>
   </meiHead>
   <music>
      <performance>
         <recording source="#take-1">
            <when xml:id="w-1" absolute="0ms" abstype="smil" corresp="ev-0001" data="#n-1"
               type="match">
               <extData type="pitch">60</extData>
               <extData type="velocity">64</extData>
               <extData type="duration">40ms</extData>
            </when>
            <when xml:id="w-2" absolute="45ms" abstype="smil" corresp="ev-0002" data="#n-1"
               type="match">
               <extData type="velocity">52</extData>
               <extData type="duration">40ms</extData>
            </when>
         </recording>
      </performance>
      <body>
         <mdiv>
            <score>
               <scoreDef meter.count="4" meter.unit="4">
                  <staffGrp>
                     <staffDef n="1" lines="5" clef.shape="G" clef.line="2"/>
                  </staffGrp>
               </scoreDef>
               <section>
                  <measure n="1" right="end">
                     <staff n="1">
                        <layer n="1">
                           <note xml:id="n-1" pname="c" oct="4" dur="4"/>
                        </layer>
                     </staff>
                     <trill xml:id="t-1" startid="#n-1"/>
                  </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>
