<?xml version="1.0" encoding="UTF-8"?>
<!-- An insertion points at no written note, so nothing but extData type='pitch' says what sounded. -->
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead>
      <fileDesc>
         <titleStmt>
            <title>An insertion with no pitch</title>
         </titleStmt>
         <pubStmt/>
      </fileDesc>
      <manifestationList>
         <manifestation xml:id="take-1">
            <physDesc>
               <p>A take.</p>
            </physDesc>
         </manifestation>
      </manifestationList>
   </meiHead>
   <music>
      <performance>
         <recording source="#take-1">
            <when xml:id="w-1" absolute="0ms" abstype="smil" corresp="ev-0001" type="insertion">
               <extData type="velocity">64</extData>
               <extData type="duration">30ms</extData>
            </when>
         </recording>
      </performance>
      <body>
         <mdiv>
            <score>
               <scoreDef meter.count="4" meter.unit="4">
                  <staffGrp>
                     <staffDef n="1" lines="5" clef.shape="G" clef.line="2"/>
                  </staffGrp>
               </scoreDef>
               <section>
                  <measure n="1" right="end">
                     <staff n="1">
                        <layer n="1">
                           <note xml:id="n-1" pname="c" oct="4" dur="4"/>
                        </layer>
                     </staff>
                  </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>
