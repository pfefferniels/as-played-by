<?xml version="1.0" encoding="UTF-8"?>
<!-- The @data resolves to nothing, so the record aligns no written note and the verovio fork drops it silently. -->
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead>
      <fileDesc>
         <titleStmt>
            <title>A when pointing at a note that is not there</title>
         </titleStmt>
         <pubStmt/>
      </fileDesc>
      <manifestationList>
         <manifestation xml:id="take-1">
            <physDesc>
               <p>A take.</p>
            </physDesc>
         </manifestation>
      </manifestationList>
   </meiHead>
   <music>
      <performance>
         <recording source="#take-1">
            <when xml:id="w-1" absolute="0ms" abstype="smil" data="#n-99" type="match"/>
         </recording>
      </performance>
      <body>
         <mdiv>
            <score>
               <scoreDef meter.count="4" meter.unit="4">
                  <staffGrp>
                     <staffDef n="1" lines="5" clef.shape="G" clef.line="2"/>
                  </staffGrp>
               </scoreDef>
               <section>
                  <measure n="1" right="end">
                     <staff n="1">
                        <layer n="1">
                           <note xml:id="n-1" pname="c" oct="4" dur="4"/>
                        </layer>
                     </staff>
                  </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>
