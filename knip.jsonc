{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Types such as PedalEvent are exported because they appear in the shape of
  // other exported types, even though they are only referenced in their own file.
  "ignoreExportsUsedInFile": true,

  // The verovio build in vendor/ is a committed artefact, not source of this project
  "ignore": ["vendor/**"]
}
